[0m$ [0m# Check staging API endpoints
for host in "api.staging.sparelabs.com" "api.staging.us.sparelabs.com"; do
  echo "=== $host ==="
  # Check regions with Bearer-x
  regions=$(curl -s -o /dev/null -w "%{http_code} %{size_download}B" "https://$host/v1/global/regions" -H "Authorization: Bearer x" 2>&1)
  noauth=$(curl -s -o /dev/null -w "%{http_code} %{size_download}B" "https://$host/v1/global/regions" 2>&1)
  echo "  regions: bearer=$regions noauth=$noauth"
  # Check organizations
  orgs=$(curl -s -o /dev/null -w "%{http_code} %{size_download}B" "https://$host/v1/global/organizations" -H "Authorization: Bearer x" 2>&1)
  echo "  organizations: bearer=$orgs"
  # Check WorkOS auth
  workos=$(curl -s -o /dev/null -w "%{http_code} %{size_download}B" -X POST "https://$host/v1/identity/workos/auth" -H "Content-Type: application/json" -d '{"domain":"spare.com","state":"test"}' 2>&1)
  echo "  workos: $workos"
  # Check terms
  terms=$(curl -s -o /dev/null -w "%{http_code} %{size_download}B" "https://$host/v1/public/terms" -H "Authorization: Bearer x" 2>&1)
  echo "  terms: $terms"
  # Check engage cases
  engage=$(curl -s -o /dev/null -w "%{http_code} %{size_download}B" "https://$host/v1/public/engage/cases" -H "Authorization: Bearer x" 2>&1)
  echo "  engage/cases: $engage"
done
