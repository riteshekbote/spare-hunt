# Check /v1/public/ namespace (some don't need auth)
for path in \
  "organizations" "organizations/$SPARE_UUID" "organizations/key/spare" \
  "regions" "terms" \
  "engage/cases" "engage/caseForms" \
  "configuration" "config" "settings" "features" "feature-flags" \
  "auth/login" "auth/signup" "auth/register" \
  "organizations/search" "organizations/list" \
  "riders" "users" "accounts" "drivers" "vehicles" \
  "organizations/$SPARE_UUID/riders" "organizations/$SPARE_UUID/drivers" \
  "organizations/$SPARE_UUID/configuration" "organizations/$SPARE_UUID/settings" "organizations/$SPARE_UUID/features" \
  "organizations/$SPARE_UUID/routes" "organizations/$SPARE_UUID/vehicles" \
  "organizations/$SPARE_UUID/zones" "organizations/$SPARE_UUID/addresses" \
  "organizations/$SPARE_UUID/fleets" "organizations/$SPARE_UUID/dispatch"; do
  result=$(curl -s -m10 -w "\t%{http_code}\t%{size_download}" "https://api.sparelabs.com/v1/public/$path" 2>/dev/null)
  code=$(echo "$result" | awk -F'\t' '{print $2}')
  size=$(echo "$result" | awk -F'\t' '{print $3}')
  if [ "$code" != "404" ] || [ "$size" != "0" ]; then
    echo "  [HIT] $path → $code ($size bytes)"
  fi
done
