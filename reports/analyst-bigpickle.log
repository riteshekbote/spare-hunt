#!/bin/bash
probe() {
  local url="$1"
  local out
  out=$(curl -s -o /tmp/opencode/body.tmp -D /tmp/opencode/hdr.tmp -w "%{http_code}" --max-time 12 -H "Origin: https://evil.example.com" "$url" 2>/dev/null)
  local sz=$(wc -c </tmp/opencode/body.tmp)
  local acao=$(grep -i "^access-control-allow-origin:" /tmp/opencode/hdr.tmp | tr -d '\r' | sed 's/^[Aa]ccess-[Cc]ontrol-[Aa]llow-[O]rigin: //')
  local ct=$(grep -i "^content-type:" /tmp/opencode/hdr.tmp | tr -d '\r' | sed 's/^[Cc]ontent-[Tt]ype: //')
  echo "$url -> HTTP $out len=$sz ct=$ct acao=$acao"
}
for p in \
  "v1/public/appConfig" \
  "v1/public/config" \
  "v1/public/regions" \
  "v1/public/apps" \
  "v1/public/application" \
  "v1/public/mobileApp" \
  "v1/public/organizations" \
  "v1/public/organizations/not-a-uuid" \
  "v1/public/mobileApp/not-a-uuid" \
  "v1/public/application/not-a-uuid" \
  "v1/public/terms/not-a-uuid" \
  "v1/public/region/not-a-uuid" \
  "v1/public/riders/not-a-uuid" \
  "v1/public/riders" \
  "v1/public/user" \
  "v1/public/users" \
  "v1/public/session" \
  "v1/public/organization" ; do
  probe "https://api.sparelabs.com/$p"
  sleep 1.2
done
EOF
chmod +x /tmp/opencode/sweep.sh
bash /tmp/opencode/sweep.sh
