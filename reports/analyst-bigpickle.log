    <!--
      Micro-frontend manifest prefetch script (generated from config/mfeConfig.js).
      
      This script fetches ALL MFE manifest URLs early (production, staging, localhost)
      and stores them in window.__MFE_MANIFESTS__ for the JS layer to use directly.
      
      Benefits:
      1. Docker containers are reusable across all environments without rebuilding
      2. Minimal network cost - fetches are non-blocking and failures are silent
      3. Bypasses HTTP cache limitations (max-age=0) by storing data in memory
      
      To add a new micro-frontend, update MFE_MANIFEST_CONFIG in config/mfeConfig.js
    -->
    <script>
      ;(function () {
        window.__MFE_MANIFESTS__ = {}
        var urls = [
                  "https://admin-eam-app.vercel.app/manifest.wc.json",
                  "https://admin-eam-app-staging.vercel.app/manifest.wc.json",
                  "https://admin-fixed-route-app.vercel.app/manifest.wc.json",
                  "https://admin-fixed-route-app-staging.vercel.app/manifest.wc.json"
        ]
        for (var i = 0; i < urls.length; i++) {
          ;(function (url) {
            fetch(url, { credentials: 'omit' })
              .then(function (r) {
                return r.ok ? r.json() : Promise.reject()
              })
              .then(function (data) {
                window.__MFE_MANIFESTS__[url] = data
              })
              .catch(function () {}) // Silently ignore failures
          })(urls[i])
