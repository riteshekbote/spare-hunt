for sub in "caseForms" "cases" "forms" "surveys" "feedback" "chats" "messages" "tickets" "requests" "contacts" "leads" "notes" "attachments" "comments" "activities" "events" "incidents" "problems" "changes" "releases" "assets" "configuration-items" "services" "SLAs" "assignments" "escalations" "resolutions" "closures" "reopenings" "merges" "splits"; do
