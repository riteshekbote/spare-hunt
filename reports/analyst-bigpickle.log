  curl -s -o /tmp/opencode/body.txt -D /tmp/opencode/hdr.txt -w "HTTP %{http_code} | total=%{time_total}s | size=%{size_download}B\n" "$@"
  grep -iE "x-envoy-upstream-service-time|access-control-allow-origin|access-control-allow-credentials" /tmp/opencode/hdr.txt | head -3
  local sz=$(stat -c%s /tmp/opencode/body.txt)
  if [ "$sz" -le 700 ]; then echo "BODY: $(cat /tmp/opencode/body.txt)"; else echo "BODY: $(head -c 700 /tmp/opencode/body.txt)..."; fi
  sleep 2
}
