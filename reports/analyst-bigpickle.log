# Use "Bearer x" auth to get 401 responses (distinguishes real from 404)
SPARE_UUID="d736519f-f384-4771-a2d2-4f95e884d790"
for path in \
  "organizations/$SPARE_UUID/riders" "organizations/$SPARE_UUID/drivers" \
  "organizations/$SPARE_UUID/configuration" "organizations/$SPARE_UUID/settings" "organizations/$SPARE_UUID/features" \
  "organizations/$SPARE_UUID/routes" "organizations/$SPARE_UUID/vehicles" \
  "organizations/$SPARE_UUID/zones" "organizations/$SPARE_UUID/addresses" \
  "organizations/$SPARE_UUID/fleets" "organizations/$SPARE_UUID/dispatch" \
  "organizations/$SPARE_UUID/billing" "organizations/$SPARE_UUID/payments" \
  "organizations/$SPARE_UUID/analytics" "organizations/$SPARE_UUID/reports" \
  "organizations/$SPARE_UUID/notifications" "organizations/$SPARE_UUID/webhooks" \
  "organizations/$SPARE_UUID/integrations" "organizations/$SPARE_UUID/api-keys" \
  "organizations/$SPARE_UUID/users" "organizations/$SPARE_UUID/members" \
  "organizations/$SPARE_UUID/roles" "organizations/$SPARE_UUID/permissions" \
  "organizations/$SPARE_UUID/sessions" "organizations/$SPARE_UUID/tokens" \
  "organizations/$SPARE_UUID/audit" "organizations/$SPARE_UUID/logs" \
  "organizations/$SPARE_UUID/alerts" "organizations/$SPARE_UUID/incidents" \
  "organizations/$SPARE_UUID/health" "organizations/$SPARE_UUID/status" \
  "organizations/$SPARE_UUID/metrics" "organizations/$SPARE_UUID/stats" \
  "organizations/$SPARE_UUID/exports" "organizations/$SPARE_UUID/imports"; do
  result=$(curl -s -m10 -w "\t%{http_code}\t%{size_download}" -H "Authorization: Bearer x" "https://api.sparelabs.com/v1/$path" 2>/dev/null)
  code=$(echo "$result" | awk -F'\t' '{print $2}')
  size=$(echo "$result" | awk -F'\t' '{print $3}')
  if [ "$code" == "401" ] && [ "$size" != "0" ]; then
    msg=$(echo "$result" | awk -F'\t' '{print $1}' | python3 -c "import sys,json; print(json.load(sys.stdin).get('name','')[:30])" 2>/dev/null)
    echo "  [401 VALID] $path ($size bytes) $msg"
  elif [ "$code" != "404" ] && [ "$code" != "401" ]; then
    echo "  [HIT $code] $path ($size bytes)"
  fi
done
