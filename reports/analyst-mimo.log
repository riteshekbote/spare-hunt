[0m$ [0m# Check orgkey for additional keys — attempt to enumerate with common patterns
for k in sparetransit transit dart mbta kingcounty cota oakville simcoe yrt hamilton hsr fvv hamiltonstreetrailway; do
  code=$(curl -s -o /dev/null -w "%{http_code}" "https://api.sparelabs.com/v1/public/organizations/key/$k" 2>&1)
