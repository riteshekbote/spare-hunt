  flags=$(echo "$body" | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('enabledPublicFeatureFlags',[])))" 2>/dev/null)
  echo "$k: ${size}B | name=$name | flags=$flags | sha256:${hash}"
done
