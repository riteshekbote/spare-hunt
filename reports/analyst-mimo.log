[0m$ [0m# Compute canonical hashes for all org-key oracle variants
for k in spare grt dallas winnipeg hsr oakville regina; do
  body=$(curl -s "https://api.sparelabs.com/v1/public/organizations/key/$k" 2>&1)
  size=$(echo -n "$body" | wc -c)
